{
  "profile": "peg",
  "paths": {
    "raw_pdfs": "data/raw_pdfs",
    "tei": "data/tei",
    "paper_json": "data/paper_json",
    "llm_raw": "data/llm_raw",
    "extracted": "data/extracted",
    "metadata": "data/metadata",
    "reference_matches": "data/reference_matches",
    "summary_memory": "data/summary_memory",
    "visual_assets": "data/visual_assets",
    "visual_analysis": "data/visual_analysis",
    "mineru": "data/mineru",
    "embeddings": "data/embeddings",
    "database": "db/literature.sqlite",
    "manifest": "data/manifest.csv",
    "review_reports": "outputs/review_reports",
    "review_queue": "outputs/review_queue.csv",
    "network_gui": "outputs/network_gui",
    "knowledge_graph": "outputs/knowledge_graph"
  },
  "grobid": {
    "base_url": "http://127.0.0.1:8070",
    "timeout_seconds": 900,
    "attempts": 4,
    "retry_wait_seconds": 5,
    "detect_image_only_pdfs": true,
    "image_only_sample_pages": 5,
    "consolidate_header": 0,
    "consolidate_citations": 0
  },
  "llm": {
    "base_url": "http://127.0.0.1:8080/v1",
    "api_key": "no-key",
    "model": "auto",
    "temperature": 0.0,
    "max_tokens": 20000,
    "timeout_seconds": 1200,
    "enable_thinking": false,
    "response_format": "json_schema",
    "chunk_max_chars": 12000,
    "attempts": 3,
    "retry_wait_seconds": 5,
    "adaptive_chunking": {
      "enabled": true,
      "max_depth": 5,
      "min_chars": 1800
    }
  },
  "metadata_enrichment": {
    "auto_accept_threshold": 0.91,
    "min_title_similarity": 0.86,
    "min_candidate_margin": 0.025,
    "crossref": {
      "enabled": true,
      "base_url": "https://api.crossref.org",
      "mailto": "",
      "user_agent": "LocalLiteratureReviewPipeline/4.0",
      "rows": 5,
      "request_interval_seconds": 0.2,
      "timeout_seconds": 40
    },
    "openalex": {
      "enabled": true,
      "base_url": "https://api.openalex.org",
      "api_key": "",
      "mailto": "",
      "user_agent": "LocalLiteratureReviewPipeline/4.0",
      "per_page": 10,
      "request_interval_seconds": 0.15,
      "timeout_seconds": 40
    },
    "direct_doi_min_title_similarity": 0.6
  },
  "reference_resolution": {
    "local_title_min_similarity": 0.87,
    "local_min_margin": 0.025,
    "external_accept_threshold": 0.86,
    "external_min_title_similarity": 0.84,
    "crossref_rows": 5,
    "max_external_queries_per_paper": 80,
    "external_query_max_chars": 350,
    "confirm_resolved_with_openalex": false,
    "local_accept_threshold": 0.9,
    "direct_doi_min_title_similarity": 0.55
  },
  "visual": {
    "render_dpi": 180,
    "crop_padding_points": 12,
    "visual_chunk_max_chars": 8000,
    "extraction_context_max_chars": 12000,
    "mineru": {
      "enabled": false,
      "command": "mineru",
      "backend": "pipeline",
      "image_analysis": true,
      "timeout_seconds": 7200,
      "effort": "high"
    },
    "vision_llm": {
      "enabled": false,
      "base_url": "http://127.0.0.1:8081/v1",
      "api_key": "no-key",
      "model": "auto",
      "temperature": 0.0,
      "max_tokens": 5000,
      "timeout_seconds": 1200,
      "enable_thinking": false
    }
  },
  "summary_memory": {
    "chunk_max_chars": 12000,
    "merge_max_chars": 24000,
    "memory_context_max_chars": 10000,
    "adaptive_chunking": {
      "enabled": true,
      "max_depth": 5,
      "min_chars": 1800
    },
    "merge_max_tokens": 20000,
    "direct_enabled": true,
    "direct_max_input_tokens": 40000,
    "direct_max_output_tokens": 4000,
    "direct_retry_enabled": true,
    "direct_retry_output_tokens": 6000
  },
  "embedding": {
    "enabled": true,
    "device": "cpu",
    "batch_size": 8,
    "max_length": 512,
    "use_summary_when_abstract_missing": true,
    "base_model": "allenai/specter2_base",
    "adapter_model": "allenai/specter2",
    "adapter_name": "proximity"
  },
  "multiplex_graph": {
    "include_validation_status": [
      "pass",
      "review_required"
    ],
    "semantic": {
      "top_k_per_paper": 10,
      "min_similarity": 0.45
    },
    "property": {
      "top_k_per_paper": 12,
      "min_jaccard": 0.12
    },
    "method": {
      "top_k_per_paper": 12,
      "min_jaccard": 0.12
    },
    "bibliographic_coupling": {
      "top_k_per_paper": 12,
      "min_similarity": 0.08,
      "min_shared_references": 1
    },
    "layer_weights": {
      "citation": 1.35,
      "semantic": 0.8,
      "property": 0.45,
      "method": 0.35,
      "bibliographic_coupling": 0.55
    },
    "clustering": {
      "resolution": 1.0,
      "seed": 42
    }
  },
  "knowledge_graph": {
    "infer_claim_relations": true,
    "relation_min_confidence": 0.75,
    "relation_batch_size": 16,
    "claim_relations": {
      "candidate_similarity_threshold": 0.3,
      "top_k_per_claim": 5,
      "max_pairs": 250
    }
  }
}

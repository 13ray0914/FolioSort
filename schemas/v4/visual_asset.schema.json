{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_type", "summary", "visible_text", "observations", "quantitative_values", "axes", "table_structure", "equation", "chemical_scheme", "uncertainties"],
  "properties": {
    "asset_type": {"type": "string", "enum": ["graph", "scheme", "table", "equation", "microscopy", "photograph", "diagram", "spectrum", "unknown"]},
    "summary": {"type": "string"},
    "visible_text": {"type": "array", "items": {"type": "string"}},
    "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "region"], "properties": {"statement": {"type": "string"}, "region": {"type": ["string", "null"]}}}},
    "quantitative_values": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "value_raw", "unit", "conditions"], "properties": {"label": {"type": "string"}, "value_raw": {"type": "string"}, "unit": {"type": ["string", "null"]}, "conditions": {"type": ["string", "null"]}}}},
    "axes": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": ["string", "null"]}, "y": {"type": ["string", "null"]}, "z": {"type": ["string", "null"]}}},
    "table_structure": {"type": "object", "additionalProperties": false, "required": ["headers", "rows_text"], "properties": {"headers": {"type": "array", "items": {"type": "string"}}, "rows_text": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}}},
    "equation": {"type": "object", "additionalProperties": false, "required": ["latex", "symbols", "interpretation"], "properties": {"latex": {"type": ["string", "null"]}, "symbols": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "meaning"], "properties": {"symbol": {"type": "string"}, "meaning": {"type": ["string", "null"]}}}}, "interpretation": {"type": ["string", "null"]}}},
    "chemical_scheme": {"type": "object", "additionalProperties": false, "required": ["reactants", "products", "catalysts_reagents", "conditions", "transformation"], "properties": {"reactants": {"type": "array", "items": {"type": "string"}}, "products": {"type": "array", "items": {"type": "string"}}, "catalysts_reagents": {"type": "array", "items": {"type": "string"}}, "conditions": {"type": "array", "items": {"type": "string"}}, "transformation": {"type": ["string", "null"]}}},
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["short_name", "review_section_title", "rationale", "distinguishing_features", "representative_paper_ids", "confidence"],
  "properties": {
    "short_name": {"type": "string", "minLength": 2, "maxLength": 100},
    "review_section_title": {"type": "string", "minLength": 4, "maxLength": 180},
    "rationale": {"type": "string", "minLength": 10, "maxLength": 1200},
    "distinguishing_features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"type": "string", "minLength": 2, "maxLength": 220}
    },
    "representative_paper_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"type": "string", "pattern": "^P[0-9]+$"}
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["article_type", "central_question", "study_design", "systems_overview", "method_map", "definitions", "major_findings", "mechanistic_model", "limitations", "global_constraints", "cross_chunk_dependencies", "section_map"],
  "properties": {
    "article_type": {"type": "string", "enum": ["primary_research", "review", "perspective", "methods", "theory", "other", "unclear"]},
    "central_question": {"type": "string"},
    "study_design": {"type": "string"},
    "systems_overview": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "statement", "evidence_sids"], "properties": {"name": {"type": "string"}, "statement": {"type": "string"}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}},
    "method_map": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "statement", "evidence_sids"], "properties": {"name": {"type": "string"}, "statement": {"type": "string"}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}},
    "definitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["term", "definition", "evidence_sids"], "properties": {"term": {"type": "string"}, "definition": {"type": "string"}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}},
    "major_findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "conditions", "evidence_sids"], "properties": {"statement": {"type": "string"}, "conditions": {"type": ["string", "null"]}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}},
    "mechanistic_model": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence_sids"], "properties": {"statement": {"type": "string"}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}},
    "global_constraints": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence_sids"], "properties": {"statement": {"type": "string"}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}},
    "cross_chunk_dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence_sids"], "properties": {"statement": {"type": "string"}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}},
    "section_map": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["heading", "summary", "evidence_sids"], "properties": {"heading": {"type": "string"}, "summary": {"type": "string"}, "evidence_sids": {"type": "array", "items": {"type": "string"}}}}}
  }
}

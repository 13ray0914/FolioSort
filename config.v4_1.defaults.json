{
  "paths": {
    "curation": "data/curation",
    "curated": "data/curated",
    "curation_outputs": "outputs/curation"
  },
  "curation": {
    "enabled": true,
    "use_curated_for_graphs": true,
    "ontology_path": "profiles/peg/ontology/terms.json",
    "feedback_bind": "127.0.0.1",
    "feedback_port": 8765,
    "actor": "",
    "auto_rebuild_literature_network": true,
    "network_rebuild_debounce_seconds": 1.5
  },
  "knowledge_graph": {
    "gui": {
      "initial_mode": "papers",
      "expand_limit": 400,
      "physics_disable_threshold": 450,
      "paper_font_size": 18,
      "paper_node_size": 24,
      "other_font_size": 12,
      "history_limit": 60
    }
  },
  "multiplex_graph": {
    "keyword": {
      "top_k_per_paper": 7,
      "min_jaccard": 0.15
    },
    "layer_weights": {
      "citation": 1.3,
      "semantic": 0.75,
      "claim": 0.3,
      "property": 0.45,
      "method": 0.35,
      "keyword": 0.25,
      "keyword_semantic": 0.2,
      "bibliographic_coupling": 0.45
    },
    "claim": {
      "top_k_per_paper": 7,
      "min_similarity": 0.12
    },
    "keyword_semantic": {
      "enabled": true,
      "llm_enabled": true,
      "candidate_top_k": 7,
      "context_top_k": 4,
      "lexical_candidate_min": 0.12,
      "context_candidate_min": 0.72,
      "max_candidate_pairs": 220,
      "llm_batch_size": 24,
      "llm_min_confidence": 0.72,
      "equivalent_weight": 1.0,
      "related_weight": 0.55,
      "top_k_per_paper": 7,
      "min_similarity": 0.1,
      "fallback_equivalent_lexical_min": 0.82,
      "fallback_related_lexical_min": 0.45,
      "fallback_related_context_min": 0.82
    },
    "gui": {
      "initial_performance_mode": "balanced",
      "profiles": {
        "fast": {
          "top_k": 3,
          "edge_factor": 4.0
        },
        "balanced": {
          "top_k": 6,
          "edge_factor": 8.0
        },
        "full": {
          "top_k": 999999,
          "edge_factor": 999999.0
        }
      },
      "layout_top_k": 6,
      "layout_edge_factor": 8.0,
      "layout_large_graph_threshold": 200,
      "layout_scale": 850.0,
      "layout_seed": 42,
      "recluster_resolution_default": 1.0,
      "recluster_resolution_min": 0.2,
      "recluster_resolution_max": 3.0,
      "recluster_resolution_step": 0.05,
      "rendering_algorithm": "maximum-spanning-forest + symmetric weighted top-k",
      "physics_default": false,
      "hide_edges_on_drag": true,
      "hide_edges_on_zoom": true,
      "smooth_edges": false
    }
  },
  "projects": {
    "enabled": true,
    "default_slug": "default",
    "raw_pdf_subdir": "projects",
    "outputs_subdir": "outputs/projects"
  },
  "summary_memory": {
    "merge_max_levels": 16,
    "merge_retry_depth": 2,
    "merge_force_item_chars": 8000
  }
}
